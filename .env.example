# ============================================
# BIHAR RECRUITMENT PORTAL - ENV TEMPLATE
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/bihar_recruitment"
# Example: DATABASE_URL="postgresql://postgres:password@localhost:5432/bihar_recruitment"

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
# NODE_ENV=production

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET=your_secret_key_change_this_in_production_make_it_long_and_secure
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================
# Get from: https://dashboard.razorpay.com/settings/api-keys

# TEST MODE (Development)
RAZORPAY_KEY_ID=rzp_test_1234567890ABCD
RAZORPAY_SECRET_KEY=test_secret_key_from_razorpay

# LIVE MODE (Production - use different keys)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# RAZORPAY_SECRET_KEY=live_secret_key_from_razorpay

# ============================================
# EMAIL SERVICE (SendGrid or Gmail)
# ============================================

# Option 1: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@bsmdo.gov.in

# Option 2: Gmail (SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# ============================================
# SMS SERVICE (Twilio)
# ============================================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ============================================
# CAPTCHA (Google reCAPTCHA)
# ============================================
# Get from: https://www.google.com/recaptcha/admin
CAPTCHA_SECRET_KEY=your_recaptcha_secret_key
CAPTCHA_THRESHOLD=0.5

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_DEV_RETURN_CODE=true

# ============================================
# REDIS (Caching & Performance)
# ============================================
# Leave empty to disable caching
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# ============================================
# AWS S3 (Backups & Storage)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BACKUP_BUCKET=bihar-recruitment-backups
S3_UPLOAD_BUCKET=bihar-recruitment-uploads

# ============================================
# FILE UPLOADS
# ============================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
UPLOAD_DIR=./uploads

# ============================================
# GST & INVOICING
# ============================================
CGST_RATE=9
SGST_RATE=9
IGST_RATE=18
GST_REGISTRATION_NUMBER=27AABCT0001H1Z0

# ============================================
# LOGIN SECURITY
# ============================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
MOCK_EXTERNAL_SERVICES=false
SEED_DATABASE=false
DETAILED_LOGS=true
# Note: Enable 2FA and generate App Password

# ============================================
# SMS SERVICE (Twilio or AWS SNS)
# ============================================

# Option 1: Twilio
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_PHONE_NUMBER=+12025551234
# Get from: https://www.twilio.com/console

# Option 2: AWS SNS
# SMS_PROVIDER=aws
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ============================================
# AWS S3 (File Uploads - Documents, Photos)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=bihar-recruitment
AWS_REGION=us-east-1
# Get from: https://aws.amazon.com/s3/

# ============================================
# ADMIN & CONTACT
# ============================================
ADMIN_EMAIL=admin@bsmdo.gov.in
ADMIN_PHONE=+919876543210
SUPPORT_EMAIL=support@bsmdo.gov.in

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yourdomain.com
# For production, specify exact domain

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
# LOG_LEVEL=info (for production)

# ============================================
# CACHE (Redis - Optional)
# ============================================
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://username:password@host:port

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_PAYMENT=true
ENABLE_SMS=false
ENABLE_EMAIL=true
ENABLE_FILE_UPLOAD=true
MAX_FILE_SIZE=5242880
# In bytes: 5242880 = 5MB

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SESSION & COOKIES
# ============================================
SESSION_SECRET=your_session_secret_key_here
COOKIE_MAX_AGE=86400000
# In milliseconds: 86400000 = 1 day

# ============================================
# EXTERNAL APIs
# ============================================
# Add any third-party API keys here
# GOOGLE_MAPS_API_KEY=
# WEATHER_API_KEY=

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set these only in development mode
SHOW_ERRORS=true
OTP_SKIP=false
# OTP_SKIP=true means OTP validation is skipped (DANGEROUS - dev only)
