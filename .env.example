# ============================================
# BIHAR RECRUITMENT PORTAL - ENV TEMPLATE
# ============================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://bihar:bihar@localhost:5432/bihar_recruitment"

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# JWT & security
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10
SESSION_SECRET=change_me_session_secret
COOKIE_MAX_AGE=86400000
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_SECRET_KEY=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@example.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+910000000000
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_PHONE_NUMBER=+910000000000

# Captcha
CAPTCHA_SECRET=your_recaptcha_secret
CAPTCHA_SECRET_KEY=your_recaptcha_secret
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_MIN_SCORE=0.5
CAPTCHA_THRESHOLD=0.5

# OTP
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_DEV_RETURN_CODE=true
OTP_SKIP=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# AWS / backups
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bihar-recruitment
S3_BACKUP_BUCKET=bihar-recruitment-backups
S3_UPLOAD_BUCKET=bihar-recruitment-uploads

# Uploads
MAX_FILE_SIZE_MB=10
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
UPLOAD_DIR=./uploads

# GST / org invoice fields
CGST_RATE=9
SGST_RATE=9
IGST_RATE=18
DEFAULT_GST_RATE_PCT=18
GST_REGISTRATION_NUMBER=27AABCT0001H1Z0
ORG_GSTIN=27AABCT0001H1Z0
ORG_LEGAL_NAME="Bihar State Mission Directorate"
ORG_ADDRESS="Patna, Bihar, India"
ORG_STATE_CODE=10

# Admit cards
ADMIT_ROLL_PREFIX=BSM

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS / admin contact
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+910000000000
SUPPORT_EMAIL=support@example.com

# Feature flags
ENABLE_PAYMENT=true
ENABLE_SMS=false
ENABLE_EMAIL=true
ENABLE_FILE_UPLOAD=true
MOCK_EXTERNAL_SERVICES=false
SEED_DATABASE=false
DETAILED_LOGS=true
SHOW_ERRORS=true
